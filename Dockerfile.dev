# ============================================
# Development Dockerfile for HRMS
# ============================================

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
# In development, we'll mount volumes for hot reload
COPY . .

# Expose port 5000
EXPOSE 5000

# Start development server with tsx
CMD ["npm", "run", "dev"]
