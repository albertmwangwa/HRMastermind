# ============================================
# Environment Variables Example
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=hrms_production
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/hrms_production

# Database Connection Details (for Docker)
PGHOST=db
PGDATABASE=hrms_production
PGUSER=postgres
PGPASSWORD=your_secure_password_here
PGPORT=5432

# Session Secret (MUST be at least 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-32-char-secret-key-here-change-this

# Email Service (Resend)
# Get your API key from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Application
NODE_ENV=production
PORT=5000
